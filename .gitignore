# Rust (default `target/` + custom `CARGO_TARGET_DIR` e.g. target-test*)
/rust/target*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Vue
/web/node_modules/
/web/dist/

# Identification experiment exports (`--output ./out`)
/out/

# Replica CLI dumps (`temain_mod --output .`)
TE_data_*.dat
/rust/tmp_out/

# Archived Fortran: compile leftovers, not sources or d*.dat
/archive/a.out
/archive/*.exe
/archive/*.o
/archive/*.obj
/archive/*.mod

# OS
.DS_Store
Thumbs.db
desktop.ini
